class Solution {
    public int nthUglyNumber(int n) {
        int[]  ugly=new int[n];
        ugly[0]=1;
        int p2=0;int p3=0; int p5=0;
        int can2=0,can3=0,can5=0;int i=1;
        while(i<n){
            can2=ugly[p2]*2;
            can3=ugly[p3]*3;
            can5=ugly[p5]*5;
            int temp=Math.min(can2,can3);
            ugly[i]=Math.min(temp,can5);
            if(ugly[i]==can2){
                p2++;
            }
            if(ugly[i]==can3){
                p3++;
            }
            if(ugly[i]==can5){
                p5++;
            }
        i++;
        }return ugly[n-1];
    }
}
