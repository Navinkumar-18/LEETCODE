import java.util.*;
class Solution {
    public int findDuplicate(int[] nums) {
        int result=0;
        HashSet<Integer> h=new HashSet<>();
        for(int i=0;i<nums.length;i++){
            if(h.contains(nums[i])){
                result=nums[i];
            }else{
                h.add(nums[i]);
            }
        }
        return result;
    }
}
