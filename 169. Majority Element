class Solution {
    public int majorityElement(int[] nums) {
        int leader=0;
        int power=0;

        for(int i=0;i<nums.length;i++){
            if(power==0){
                leader=nums[i];

            }
            if(nums[i]==leader){
                power++;
            }else{
                power--;
            }
        }
        return leader;
    }
}
