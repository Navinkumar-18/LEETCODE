class Solution {
    public int numJewelsInStones(String jewels, String stones) {
    int count =0;
    char[] j=jewels.toCharArray();
    char[] s=stones.toCharArray();
    for(int i=0;i<s.length;i++){
        for(int k=0;k<j.length;k++)
        if(j[k]==s[i]){
            count++;
        }
    }


       return count;
        
    }
}
